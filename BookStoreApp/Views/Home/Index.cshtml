@model BookStoreApp.ViewModels.HomeViewModel

@section Styles {
    <style>
        .book-card {
            border: 1px solid #ccc;
            padding: 15px;
            margin: 10px;
            width: 250px;
            border-radius: 5px;
            box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
        }
    </style>
}

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm("Remove this book?");
        }
    </script>
}

<h2>Book Store Management</h2>

<div class="row mt-4">
    <div class="col-md-6">
        <h4>Add New Book</h4>
        <form method="post" action="/Home/AddBook">
            <div class="mb-2">
                <label>Title:</label>
                <input type="text" name="title" class="form-control" required />
            </div>
            <div class="mb-2">
                <label>Price:</label>
                <input type="number" step="0.01" name="price" class="form-control" required />
            </div>
            <div class="mb-2">
                <label>Author:</label>
                <select name="authorId" class="form-control">
                    @if (Model.Authors != null)
                    {
                        @foreach (var author in Model.Authors)
                        {
                            <option value="@author.Id">@author.Name</option>
                        }
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Add Book</button>
        </form>
    </div>

    <div class="col-md-6">
        <h4>Add New Author</h4>
        <form method="post" action="/Home/AddAuthor">
            <div class="mb-2">
                <label>Name:</label>
                <input type="text" name="name" class="form-control" required />
            </div>
            <div class="mb-2">
                <label>Country:</label>
                <input type="text" name="country" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-success mt-2">Add Author</button>
        </form>
    </div>
</div>

<hr class="my-4" />

<h3>Books List</h3>

@if (Model.Books == null || Model.Books.Count == 0)
{
    <p class="alert alert-warning">No books available</p>
}
else
{
    <div class="d-flex flex-wrap">
        @foreach (var book in Model.Books)
        {
            <div class="book-card">
                <h5>@book.Title</h5>
                <p><strong>Author:</strong> @book.AuthorName</p>
                <p><strong>Price:</strong> $@book.Price</p>
                <form method="post" action="/Home/RemoveBook" onsubmit="return confirmDelete();">
                    <input type="hidden" name="id" value="@book.Id" />
                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                </form>
            </div>
        }
    </div>
}